#!/usr/bin/env bash
# Clabby pre-commit hook: auto-format staged files so the CI fmt gate (§8/§9)
# never fails on formatting alone. Rust -> `cargo fmt`; frontend -> Biome.
# Enabled via `git config core.hooksPath scripts/hooks` (run scripts/install-hooks).
# Only staged files are touched, and anything reformatted is re-staged.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Collect staged (added/copied/modified) files, NUL-separated for safe paths.
mapfile -d '' staged < <(git diff --cached --name-only --diff-filter=ACM -z)

rust_files=()
fe_files=()
for f in "${staged[@]}"; do
  case "$f" in
    *.rs) rust_files+=("$f") ;;
    ui/*.ts | ui/*.tsx | ui/*.js | ui/*.jsx | ui/*.json | ui/*.css)
      # Strip the leading `ui/` so the path is relative to the Biome project.
      fe_files+=("${f#ui/}")
      ;;
  esac
done

if [ "${#rust_files[@]}" -gt 0 ]; then
  echo "pre-commit: cargo fmt (${#rust_files[@]} Rust file(s))"
  cargo fmt --all
  git add -- "${rust_files[@]}"
fi

if [ "${#fe_files[@]}" -gt 0 ]; then
  echo "pre-commit: biome (${#fe_files[@]} frontend file(s))"
  ( cd ui && pnpm exec biome check --write --no-errors-on-unmatched "${fe_files[@]}" )
  # Re-stage from the repo root with the original `ui/`-prefixed paths.
  git add -- "${fe_files[@]/#/ui/}"
fi

exit 0
