#!/bin/sh
# Opt-in pre-push gate. Enabled (with the pre-commit hook) via:
#   git config core.hooksPath scripts/hooks   (run ./scripts/install-hooks.sh)
# Runs the same checks as CI so a red push never reaches the remote (Article 12).
set -e
echo "pre-push: running local CI..."
cargo fmt --all -- --check
cargo clippy --workspace --all-targets -- -D warnings
cargo test --workspace
echo "pre-push: OK"
